# Baza. Ko'rsatilmasa — backend/shgat.db (SQLite)
# DATABASE_URL=postgresql+psycopg://shgat:shgat@localhost:5432/shgat
DATABASE_URL=sqlite:///./shgat.db

# Yuklangan fayllar papkasi
UPLOAD_DIR=./uploads

# Ochiq ArcGIS qatlami (token kerak emas)
ARCGIS_LAYER_URL=https://sampleserver6.arcgisonline.com/arcgis/rest/services/Wildfire/FeatureServer/2
ARCGIS_TIMEOUT=15
ARCGIS_RETRIES=3

# Frontend manzili (CORS), vergul bilan bir nechta
CORS_ORIGINS=http://localhost:5173
