# /etc/shgat/shgat.env — serverdagi sozlamalar (git'ga tushmaydi)
DATABASE_URL=sqlite:////var/lib/shgat/shgat.db
UPLOAD_DIR=/var/lib/shgat/uploads
FRONTEND_DIR=/opt/shgat/frontend
ARCGIS_LAYER_URL=https://sampleserver6.arcgisonline.com/arcgis/rest/services/Wildfire/FeatureServer/2
ARCGIS_TIMEOUT=15
ARCGIS_RETRIES=3
CORS_ORIGINS=https://shgat.abbostech.uz
# JWT_SECRET deploy.sh tomonidan serverda avtomatik yaratiladi (openssl rand -hex 32)
ALLOW_X_ROL=false
